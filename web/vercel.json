{
  "headers": [
    {
      "source": "/assets/(.*)\\.mjs",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*)\\.pmtiles",
      "headers": [
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Content-Type", "value": "application/octet-stream" }
      ]
    }
  ]
}
